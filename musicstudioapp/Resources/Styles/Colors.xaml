<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Core Background -->
    <Color x:Key="AppBg">#070A12</Color>
    <Color x:Key="Surface">#0D1321</Color>
    <Color x:Key="SurfaceElevated">#111827</Color>
    <Color x:Key="SurfaceSoft">#1E293B</Color>
    <Color x:Key="SurfaceHover">#243044</Color>

    <!-- Brand Colors -->
    <Color x:Key="Primary">#7C3AED</Color>
    <Color x:Key="PrimaryLight">#A78BFA</Color>
    <Color x:Key="PrimaryDark">#5B21B6</Color>

    <Color x:Key="Accent">#38BDF8</Color>
    <Color x:Key="AccentSoft">#0EA5E9</Color>

    <Color x:Key="Success">#22C55E</Color>
    <Color x:Key="Warning">#F97316</Color>
    <Color x:Key="Danger">#EF4444</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#F8FAFC</Color>
    <Color x:Key="TextSecondary">#CBD5E1</Color>
    <Color x:Key="TextMuted">#94A3B8</Color>
    <Color x:Key="TextDim">#64748B</Color>

    <!-- Borders -->
    <Color x:Key="StrokeSoft">#1F2937</Color>
    <Color x:Key="StrokeStrong">#334155</Color>

    <!-- Base -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">#00000000</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBg}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevated}" />
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{StaticResource SurfaceSoft}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="StrokeSoftBrush" Color="{StaticResource StrokeSoft}" />

</ResourceDictionary>