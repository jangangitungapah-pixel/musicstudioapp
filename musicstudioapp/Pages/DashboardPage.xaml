<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="musicstudioapp.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    Title="Dashboard"
    BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout
            x:Name="RootContent"
            Padding="24"
            Spacing="22"
            Opacity="0"
            TranslationY="18">

            <!-- HERO -->
            <Border
                x:Name="HeroCard"
                Style="{StaticResource GlassCard}">

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="18">

                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label
                            Text="37 Music Studio"
                            Style="{StaticResource PageTitle}" />

                        <Label
                            Text="Control room untuk booking, billing, inventory, dan pembukuan studio."
                            Style="{StaticResource MutedText}" />

                        <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                            <Border
                                StrokeShape="RoundRectangle 99"
                                BackgroundColor="#18233A"
                                Stroke="{StaticResource StrokeSoft}"
                                Padding="12,7">

                                <Label
                                    x:Name="TodayStatusLabel"
                                    Text="Live Today"
                                    TextColor="{StaticResource Accent}"
                                    FontAttributes="Bold"
                                    FontSize="12" />
                            </Border>

                            <Border
                                StrokeShape="RoundRectangle 99"
                                BackgroundColor="#1C1830"
                                Stroke="{StaticResource StrokeSoft}"
                                Padding="12,7">

                                <Label
                                    Text="Studio Ops"
                                    TextColor="{StaticResource PrimaryLight}"
                                    FontAttributes="Bold"
                                    FontSize="12" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        StrokeShape="RoundRectangle 26"
                        BackgroundColor="#101A2D"
                        Stroke="#273653"
                        Padding="18"
                        WidthRequest="130"
                        HorizontalOptions="End"
                        VerticalOptions="Center">

                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label
                                Text="Revenue"
                                TextColor="{StaticResource TextMuted}"
                                FontSize="12"
                                HorizontalTextAlignment="Center" />

                            <Label
                                x:Name="HeroRevenueLabel"
                                Text="Rp 0"
                                TextColor="{StaticResource TextPrimary}"
                                FontSize="20"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="today"
                                TextColor="{StaticResource TextDim}"
                                FontSize="11"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>
            </Border>

            <!-- METRICS -->
            <Grid
                x:Name="MetricsGrid"
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="14"
                RowSpacing="14">

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ModernCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Booking Hari Ini" TextColor="{StaticResource TextMuted}" FontSize="13" />
                        <Label x:Name="TodayBookingsLabel" Text="0" TextColor="{StaticResource TextPrimary}" FontSize="34" FontAttributes="Bold" />
                        <Label x:Name="TodayBookingSubtitleLabel" Text="jadwal aktif" TextColor="{StaticResource TextDim}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Pendapatan Hari Ini" TextColor="{StaticResource TextMuted}" FontSize="13" />
                        <Label x:Name="TodayRevenueLabel" Text="Rp 0" TextColor="{StaticResource TextPrimary}" FontSize="24" FontAttributes="Bold" />
                        <Label Text="invoice paid dummy" TextColor="{StaticResource TextDim}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ModernCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Total Customer" TextColor="{StaticResource TextMuted}" FontSize="13" />
                        <Label x:Name="TotalCustomersLabel" Text="0" TextColor="{StaticResource TextPrimary}" FontSize="34" FontAttributes="Bold" />
                        <Label Text="database customer" TextColor="{StaticResource TextDim}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Low Stock" TextColor="{StaticResource TextMuted}" FontSize="13" />
                        <Label x:Name="LowStockLabel" Text="0" TextColor="{StaticResource Warning}" FontSize="34" FontAttributes="Bold" />
                        <Label Text="butuh perhatian" TextColor="{StaticResource TextDim}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- CHART -->
            <Border
                x:Name="RevenueCard"
                Style="{StaticResource GlassCard}">

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Revenue Overview" Style="{StaticResource SectionTitle}" />
                            <Label Text="Simulasi tren pendapatan mingguan studio" Style="{StaticResource MutedText}" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            StrokeShape="RoundRectangle 99"
                            BackgroundColor="#102033"
                            Stroke="{StaticResource StrokeSoft}"
                            Padding="12,7"
                            VerticalOptions="Start">

                            <Label
                                x:Name="RevenueGrowthLabel"
                                Text="+0%"
                                TextColor="{StaticResource Success}"
                                FontAttributes="Bold"
                                FontSize="12" />
                        </Border>
                    </Grid>

                    <lvc:CartesianChart
                        HeightRequest="220"
                        Series="{Binding RevenueSeries}"
                        XAxes="{Binding RevenueXAxes}"
                        YAxes="{Binding RevenueYAxes}"
                        LegendPosition="Hidden"
                        TooltipPosition="Top" />

                </VerticalStackLayout>
            </Border>

            <!-- CONTENT GRID -->
            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto"
                ColumnSpacing="14">

                <!-- UPCOMING BOOKINGS -->
                <Border
                    x:Name="BookingCard"
                    Grid.Column="0"
                    Style="{StaticResource GlassCard}">

                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Booking Terdekat" Style="{StaticResource SectionTitle}" />
                                <Label Text="Antrian jadwal yang akan datang" Style="{StaticResource MutedText}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Lihat"
                                Style="{StaticResource GhostButton}"
                                HeightRequest="42"
                                Padding="14,8" />
                        </Grid>

                        <CollectionView x:Name="UpcomingBookingsView">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Style="{StaticResource ModernCard}"
                                        Padding="14"
                                        Margin="0,0,0,10">

                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">

                                            <Border
                                                Grid.RowSpan="2"
                                                WidthRequest="42"
                                                HeightRequest="42"
                                                StrokeShape="RoundRectangle 16"
                                                BackgroundColor="#11233A"
                                                Stroke="{StaticResource StrokeSoft}">

                                                <Label
                                                    Text="♪"
                                                    TextColor="{StaticResource Accent}"
                                                    FontSize="20"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding CustomerName}"
                                                TextColor="{StaticResource TextPrimary}"
                                                FontSize="15"
                                                FontAttributes="Bold" />

                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding Status}"
                                                TextColor="{StaticResource Accent}"
                                                FontSize="11"
                                                FontAttributes="Bold" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Text="{Binding ScheduleText}"
                                                TextColor="{StaticResource TextMuted}"
                                                FontSize="12" />

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!-- INVENTORY ALERTS -->
                <Border
                    x:Name="InventoryCard"
                    Grid.Column="1"
                    Style="{StaticResource GlassCard}">

                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Inventory Alert" Style="{StaticResource SectionTitle}" />
                                <Label Text="Barang yang stoknya mulai kritis" Style="{StaticResource MutedText}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Restock"
                                Style="{StaticResource PrimaryButton}"
                                HeightRequest="42"
                                Padding="14,8" />
                        </Grid>

                        <CollectionView x:Name="LowStockItemsView">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Style="{StaticResource ModernCard}"
                                        Padding="14"
                                        Margin="0,0,0,10">

                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">

                                            <Label
                                                Text="{Binding Name}"
                                                TextColor="{StaticResource TextPrimary}"
                                                FontSize="15"
                                                FontAttributes="Bold" />

                                            <Border
                                                Grid.Column="1"
                                                StrokeShape="RoundRectangle 99"
                                                BackgroundColor="#2C1B11"
                                                Stroke="#4A2B17"
                                                Padding="10,5">

                                                <Label
                                                    Text="{Binding StockText}"
                                                    TextColor="{StaticResource Warning}"
                                                    FontSize="11"
                                                    FontAttributes="Bold" />
                                            </Border>

                                            <Label
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Text="{Binding Notes}"
                                                TextColor="{StaticResource TextMuted}"
                                                FontSize="12" />

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>